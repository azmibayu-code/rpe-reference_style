<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="en-US">
  <info>
    <title>Radiation Physics and Engineering (RPE, author-year)</title>
    <title-short>RPE</title-short>
    <id>http://www.zotero.org/styles/radiation-physics-and-engineering-rpe-author-year</id>
    <link href="http://www.zotero.org/styles/radiation-physics-and-engineering-rpe-author-year" rel="self"/>
    <link href="https://rpe.kntu.ac.ir/journal/authors.note" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="physics"/>
    <summary>Custom style built from the RPE (K. N. Toosi University of Technology) APA-based reference template. Up to 3 authors listed, then et al.; journal title in full and italic; Volume: pages; DOI as https://doi.org/.</summary>
    <updated>2026-11-25T08:00:00+07:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">
        <single>Ed.</single>
        <multiple>Eds.</multiple>
      </term>
      <term name="translator" form="short">
        <single>Trans.</single>
        <multiple>Trans.</multiple>
      </term>
      <term name="et-al">et al.</term>
      <term name="no date" form="short">n.d.</term>
    </terms>
  </locale>

  <!-- ========== NAMES ========== -->
  <macro name="author-bib">
    <names variable="author" suffix=".">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never" delimiter-precedes-et-al="always" et-al-min="4" et-al-use-first="3"/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never" delimiter-precedes-et-al="always" et-al-min="4" et-al-use-first="3"/>
          <label form="short" prefix=" (" suffix=")."/>
        </names>
        <names variable="translator">
          <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", " and="text" delimiter-precedes-last="never" delimiter-precedes-et-al="always" et-al-min="4" et-al-use-first="3"/>
          <label form="short" prefix=" (" suffix=")."/>
        </names>
        <text macro="title-bib"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-cite">
    <names variable="author">
      <name form="short" and="text" delimiter=", " initialize-with="."/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title" form="short" font-style="italic"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " initialize-with="." delimiter=", "/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor-in">
    <names variable="editor">
      <name and="text" initialize-with="." delimiter=", " delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="editor-paren">
    <names variable="editor" prefix="(" suffix=")">
      <name and="text" initialize-with="." delimiter=", " delimiter-precedes-last="never"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <macro name="translator-paren">
    <names variable="translator" prefix="(" suffix=")">
      <name and="text" initialize-with="." delimiter=", " delimiter-precedes-last="never"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>

  <!-- ========== DATES ========== -->
  <macro name="year">
    <choose>
      <if variable="issued">
        <group>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </group>
      </if>
      <else>
        <group>
          <text term="no date" form="short"/>
          <text variable="year-suffix" prefix="-"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="date-bib">
    <choose>
      <if type="webpage post post-weblog" match="any">
        <group delimiter=", ">
          <text macro="year"/>
          <date variable="issued">
            <date-part name="month"/>
            <date-part name="day" prefix=" "/>
          </date>
        </group>
      </if>
      <else>
        <text macro="year"/>
      </else>
    </choose>
  </macro>

  <!-- ========== TITLES ========== -->
  <macro name="title-bib">
    <choose>
      <if type="article-journal article-magazine article-newspaper paper-conference chapter entry-encyclopedia entry-dictionary" match="any">
        <text variable="title"/>
      </if>
      <else>
        <text variable="title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <!-- ========== PIECES ========== -->
  <macro name="volume-pages">
    <group delimiter=": ">
      <text variable="volume"/>
      <choose>
        <if variable="page">
          <text variable="page"/>
        </if>
        <else>
          <text variable="number"/>
        </else>
      </choose>
    </group>
  </macro>

  <macro name="journal-block">
    <group delimiter=" ">
      <choose>
        <if variable="container-title">
          <text variable="container-title" font-style="italic" text-case="title"/>
        </if>
        <else>
          <text variable="collection-title" font-style="italic" text-case="title"/>
        </else>
      </choose>
      <text macro="volume-pages"/>
    </group>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group prefix="(" suffix=")" delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text value="edition"/>
        </group>
      </if>
      <else>
        <text variable="edition" prefix="(" suffix=")"/>
      </else>
    </choose>
  </macro>

  <macro name="volume-book">
    <group prefix="(" suffix=")" delimiter=" ">
      <text term="volume" form="short" text-case="capitalize-first"/>
      <text variable="volume"/>
    </group>
  </macro>

  <macro name="pages-chapter">
    <group prefix="(" suffix=")" delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="version">
    <group prefix="(" suffix=")" delimiter=" ">
      <text value="Version"/>
      <text variable="version"/>
    </group>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if type="webpage post post-weblog dataset software report" match="any">
        <text variable="URL"/>
      </else-if>
      <else-if variable="container-title collection-title page volume" match="none">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <!-- ========== BODY BY TYPE ========== -->
  <macro name="body">
    <choose>
      <if type="article-journal article-magazine article-newspaper paper-conference" match="any">
        <group delimiter=". ">
          <text macro="title-bib"/>
          <text macro="journal-block"/>
        </group>
      </if>
      <else-if type="chapter entry-encyclopedia entry-dictionary" match="any">
        <group delimiter=". ">
          <text macro="title-bib"/>
          <group delimiter=" ">
            <text term="in" text-case="capitalize-first"/>
            <group delimiter=", ">
              <text macro="editor-in"/>
              <text variable="container-title" font-style="italic"/>
            </group>
          </group>
          <text macro="pages-chapter"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="thesis">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="title-bib"/>
            <text variable="number" prefix="(Publication No. " suffix=")"/>
            <group prefix="[" suffix="]" delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
            </group>
          </group>
          <text variable="archive"/>
        </group>
      </else-if>
      <else-if type="dataset">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="title-bib"/>
            <text macro="version"/>
            <text value="[Data set]"/>
          </group>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="software">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="title-bib"/>
            <text macro="version"/>
          </group>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="report">
        <group delimiter=". ">
          <group delimiter=" ">
            <text macro="title-bib"/>
            <text variable="number" prefix="(" suffix=")"/>
          </group>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else-if type="webpage post post-weblog" match="any">
        <group delimiter=". ">
          <text macro="title-bib"/>
          <text variable="container-title"/>
        </group>
      </else-if>
      <else-if type="book">
        <group delimiter=". ">
          <text macro="title-bib"/>
          <text macro="volume-book"/>
          <text macro="edition"/>
          <text macro="editor-paren"/>
          <text macro="translator-paren"/>
          <text variable="publisher"/>
        </group>
      </else-if>
      <else>
        <group delimiter=". ">
          <text macro="title-bib"/>
          <text macro="journal-block"/>
          <text variable="publisher"/>
        </group>
      </else>
    </choose>
  </macro>

  <!-- ========== CITATION ========== -->
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-givenname="true" givenname-disambiguation-rule="by-cite" collapse="year" cite-group-delimiter=", ">
    <sort>
      <key macro="author-sort" names-min="999" names-use-first="999"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-cite"/>
        <text macro="year"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- ========== BIBLIOGRAPHY ========== -->
  <bibliography hanging-indent="true" entry-spacing="0">
    <sort>
      <key macro="author-sort" names-min="999" names-use-first="999"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author-bib"/>
        <text macro="date-bib" prefix="(" suffix=")."/>
      </group>
      <text macro="body" prefix=" " suffix="."/>
      <text macro="access" prefix=" "/>
      <date variable="original-date" prefix=" (Original work published " suffix=")">
        <date-part name="year"/>
      </date>
    </layout>
  </bibliography>
</style>
